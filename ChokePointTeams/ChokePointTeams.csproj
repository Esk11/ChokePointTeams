<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ChokePointTeams</AssemblyName>
    <ApplicationIcon>choke-point-glyph.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>ChokePoint for Teams</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="ui\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="WinDivert.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="WinDivert64.sys" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="licenses\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
